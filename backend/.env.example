# Variáveis da Edge Function `quiz`. Nunca comite o .env real.
# Em produção: supabase secrets set --env-file backend/.env
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem nas Edge Functions do projeto.)

# Domínios do quiz, separados por vírgula. Vazio aceita qualquer origem (só para testar).
ALLOWED_ORIGINS=https://quiz.seudominio.com.br

# Sal do hash do IP (limite de sessões por hora). Gere com: openssl rand -hex 32
QUIZ_IP_SALT=
